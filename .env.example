DATABASE_URL=postgresql+psycopg://tuition:tuition@localhost:5433/tuition
TEST_DATABASE_URL=postgresql+psycopg://tuition:tuition@localhost:5433/tuition_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

CORS_ORIGINS=["http://localhost:3000"]

# Local time used for "today": class days, fees and door scans.
TIMEZONE=Asia/Colombo

# Uploaded files (tute PDFs), and the largest upload allowed.
STORAGE_DIR=storage
MAX_UPLOAD_MB=20
